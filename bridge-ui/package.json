{
  "name": "zeko-ethereum-bridge-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "config:write": "node scripts/write-runtime-config.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run && pnpm test:vendor",
    "test:vendor": "node scripts/check-vendored-sdk.mjs",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:live": "playwright test --config playwright.live.config.ts"
  },
  "dependencies": {
    "@zeko-labs/bridge-sdk": "file:vendor/zeko-labs-bridge-sdk-0.3.4.tgz",
    "@zeko-labs/eth-bridge-sdk": "file:vendor/zeko-labs-eth-bridge-sdk-0.1.0.tgz",
    "o1js": "2.8.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "viem": "2.55.2"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vite": "6.1.0",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@10.19.0",
  "pnpm": {
    "overrides": {
      "@zeko-labs/bridge-sdk": "file:vendor/zeko-labs-bridge-sdk-0.3.4.tgz"
    }
  }
}
