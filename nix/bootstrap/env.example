# Example values for compose.yaml (preparation example feeding task 05).
# Copy to <workspace>/.env (chmod 0600) and fill in every value. The workspace
# must be a persistent directory OUTSIDE all source checkouts; never keep this
# file or any generated material under a repository (nix/README.md).
# No defaults are shipped for anything secret or host-specific: the bootstrap
# refuses to start without them.

# Absolute path of this workspace (the directory holding this file).
ZEKO_BOOTSTRAP_WORKSPACE=
# Numeric uid/gid owning the workspace; every custom container runs as them
# (`id -u`, `id -g`). Private files stay 0600/0700 and need no chown.
ZEKO_BOOTSTRAP_UID=
ZEKO_BOOTSTRAP_GID=

# Loaded image references (docker.io/zekolabs/<name>:<release-tag>). Nothing
# here claims they are published; load or pull them first.
ZEKO_IMAGE=
ZEKO_DA_IMAGE=
ZEKO_BOOTSTRAP_IMAGE=
# zeko commit the ZEKO_IMAGE/ZEKO_DA_IMAGE were built from; written into
# deployment-manifest.json by the exporter (the images do not know it).
ZEKO_SOURCE_REVISION=

# Zeko signing network id used by signer, DA, bootstrap L1 and exporter
# (default testnet).
MINA_SIGNING_NETWORK_ID=testnet

# Scratch service credentials for the internal-only network. Use fresh random
# values, [A-Za-z0-9] only (they are embedded in connection URIs). The broker
# user must not be `guest`.
ZEKO_BOOTSTRAP_POSTGRES_PASSWORD=
ZEKO_BOOTSTRAP_RABBITMQ_USER=zeko
ZEKO_BOOTSTRAP_RABBITMQ_PASSWORD=

# Public address of the admin/deployer wallet (cast wallet new). The matching
# private key goes into secrets/deployer_key, never here. Used by
# predict-address and deploy.
ADMIN_ADDRESS=
