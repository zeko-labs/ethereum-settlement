# Every image must be immutable. Tags, including `latest`, are rejected by
# tools/testnet-preflight.sh.
GATEWAY_IMAGE='registry.example/zeko-gateway@sha256:<64-hex-digest>'
ZEKO_IMAGE='registry.example/zeko@sha256:<64-hex-digest>'
ZEKO_DA_IMAGE='registry.example/zeko-da@sha256:<64-hex-digest>'
POSTGRES_IMAGE='postgres@sha256:<64-hex-digest>'
RABBITMQ_IMAGE='rabbitmq@sha256:<64-hex-digest>'

GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8080
SEQUENCER_BIND_ADDRESS=127.0.0.1
SEQUENCER_PORT=1923

# Three distinct compressed Mina DA public keys, comma-separated.
DA_PUBLIC_KEYS=
# Even Mina key used by the sequencer signer, fee payer, pause key, and
# sequencer key in the bounded PoC genesis.
SEQUENCER_PUBLIC_KEY=
# Even Mina key retained by the bridge demo user. It must match the recipient
# bound into bridge-scenario.json.
BRIDGE_RECIPIENT_PUBLIC_KEY=
