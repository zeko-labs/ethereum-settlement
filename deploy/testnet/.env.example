# Every image must be immutable. Tags, including `latest`, are rejected by
# tools/testnet-preflight.sh.
GATEWAY_IMAGE='registry.example/zeko-gateway@sha256:<64-hex-digest>'
ZEKO_IMAGE='registry.example/zeko@sha256:<64-hex-digest>'
ZEKO_DA_IMAGE='registry.example/zeko-da@sha256:<64-hex-digest>'
POSTGRES_IMAGE='postgres@sha256:<64-hex-digest>'
RABBITMQ_IMAGE='rabbitmq@sha256:<64-hex-digest>'

GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8080
SEQUENCER_BIND_ADDRESS=127.0.0.1
SEQUENCER_PORT=1923
# Ethereum PoC default. Mina-only deployments keep the OCaml CLI default.
ZEKO_COMMITMENT_PERIOD_SECONDS=900

# Auro currently signs every custom Mina network with the `testnet` network ID.
# Keep this exact PoC value aligned across Auro, the sequencer, and DA signers.
MINA_SIGNING_NETWORK_ID=testnet

# The Actions API and indexer run from this pinned local Zeko UI checkout.
ACTIONS_DB_BIND_ADDRESS=127.0.0.1
ACTIONS_DB_PORT=5434
ACTIONS_INDEXER_PORT=9100
ACTIONS_API_BIND_ADDRESS=127.0.0.1
ACTIONS_API_PORT=9101
ZEKO_UI_ROOT=/root/zeko-ui
ZEKO_UI_COMMIT=26b1c8783c78aafc144ae1cc17790b61952285c5

# Public role identities. tools/init-machine-testnet-identity.sh fills these.
ADMIN_ADDRESS=
UPGRADER_ADDRESS=
GATEWAY_PROVER_ADDRESS=

# Three distinct compressed Mina DA public keys, comma-separated.
DA_PUBLIC_KEYS=
# Even Mina key used by the sequencer signer, fee payer, pause key, and
# sequencer key in the bounded PoC genesis.
SEQUENCER_PUBLIC_KEY=
# Even Mina key retained by the bridge demo user. It must match the recipient
# bound into bridge-scenario.json.
BRIDGE_RECIPIENT_PUBLIC_KEY=
